# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# مجلد فك ضغط تصدير إنستقرام (مؤقت وكبير — الصور المستوردة تُحفظ في public/instagram)
/.instagram-export/

# قاعدة البيانات وملفات الزبائن المرفوعة — بيانات شخصية، لا تُرفع أبدًا
/data/

# لقطات مراجعة التصميم
/.impeccable/review/
/.impeccable/questions/

# وثيقة العمل الحر — تحمل رقم الهوية، لا تُرفع أبدًا
/public/cr.*
